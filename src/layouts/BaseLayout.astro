---
// src/layouts/BaseLayout.astro
import { ClientRouter } from 'astro:transitions';
import '../styles/globals.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QuickBill POS - Cloud Admin Command Center',
  description = 'Cloud POS Admin Panel for live store inventory, real-time sync, and sales performance analytics.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090d16" />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Astro SPA Client Router for smooth, instant transitions without page reload -->
    <ClientRouter />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen antialiased flex flex-col selection:bg-indigo-500/30 selection:text-indigo-200">
    <slot />

    <!-- Clean legacy caches & unregister any old Service Workers -->
    <script is:inline>
      (function () {
        // 1. Unregister all Service Workers
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then(function (registrations) {
            for (var i = 0; i < registrations.length; i++) {
              registrations[i].unregister();
            }
          }).catch(function () {});
        }

        // 2. Clear CacheStorage
        if ('caches' in window) {
          caches.keys().then(function (names) {
            for (var i = 0; i < names.length; i++) {
              caches.delete(names[i]);
            }
          }).catch(function () {});
        }

        // 3. Clean up stale legacy keys
        try {
          var staleKeys = ['__next', 'next-auth', '__NEXT_DATA__', 'qbpos_sw_reloaded'];
          for (var i = 0; i < staleKeys.length; i++) {
            localStorage.removeItem(staleKeys[i]);
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
